@page "/mission-control"
@using Glacier.Showcase.Services
@using System.Threading
@inject MissionControlService MissionControlSvc
@rendermode InteractiveServer

<PageTitle>Glacier Mission Control - Real-Time .NET 10 Visual Cockpit</PageTitle>

<div class="mc-container">
    <!-- Header HUD -->
    <header class="mc-header">
        <div class="header-left">
            <div class="pulse-indicator"></div>
            <div>
                <h1 class="mc-title">GLACIER MISSION CONTROL</h1>
                <p class="mc-subtitle">Real-Time Pure C# .NET 10 Hardware, Architecture & Training Telemetry</p>
            </div>
        </div>
        <div class="hud-badges">
            <div class="hud-badge cyan">
                <span class="badge-label">COLD START</span>
                <span class="badge-val">&lt; 15 ms</span>
            </div>
            <div class="hud-badge green">
                <span class="badge-label">FINE-TUNING</span>
                <span class="badge-val">20 Mins (13x Python)</span>
            </div>
            <div class="hud-badge purple">
                <span class="badge-label">PAGEDATTENTION</span>
                <span class="badge-val">87.5% VRAM SAVED</span>
            </div>
            <div class="hud-badge magenta">
                <span class="badge-label">ARCHITECTURE</span>
                <span class="badge-val">100% Pure C# .NET 10</span>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="mc-tabs">
        <button class="mc-tab @(ActiveTab == "speedometer" ? "active" : "")" @onclick='() => SetTab("speedometer")'>
            ⚡ Inference Speedometer
        </button>
        <button class="mc-tab @(ActiveTab == "loss" ? "active" : "")" @onclick='() => SetTab("loss")'>
            📉 Fine-Tuning Loss Monitor
        </button>
        <button class="mc-tab @(ActiveTab == "graph" ? "active" : "")" @onclick='() => SetTab("graph")'>
            🕸️ 3D Knowledge Graph
        </button>
        <button class="mc-tab @(ActiveTab == "vector" ? "active" : "")" @onclick='() => SetTab("vector")'>
            🔥 Vector Heatmap & Memory
        </button>
        <button class="mc-tab @(ActiveTab == "paged" ? "active" : "")" @onclick='() => SetTab("paged")'>
            🧠 PagedAttention Pool
        </button>
    </nav>

    <!-- Content Body -->
    <main class="mc-content">
        @if (ActiveTab == "speedometer")
        {
            <div class="speedometer-grid">
                <!-- Left: Gauge and Controls -->
                <div class="glass-card gauge-panel">
                    <h3 class="panel-heading">Real-Time Autoregressive Speedometer</h3>
                    
                    <div class="gauge-wrapper">
                        <svg class="gauge-svg" viewBox="0 0 300 170">
                            <!-- Background Arc -->
                            <path d="M 30 150 A 120 120 0 0 1 270 150" fill="none" stroke="#162238" stroke-width="22" stroke-linecap="round" />
                            <!-- Active Arc -->
                            <path d="M 30 150 A 120 120 0 0 1 270 150" fill="none" stroke="url(#gaugeGradient)" stroke-width="22" stroke-linecap="round"
                                  stroke-dasharray="377" stroke-dashoffset="@(377 - (377 * Math.Clamp(CurrentTokensPerSec / 100.0, 0.0, 1.0)))" />
                            <!-- Needle -->
                            <line x1="150" y1="150" x2="150" y2="45" stroke="#ff0077" stroke-width="4" stroke-linecap="round"
                                  style="transform-origin: 150px 150px; transform: rotate(@(-90 + (180 * Math.Clamp(CurrentTokensPerSec / 100.0, 0.0, 1.0)))deg); transition: transform 0.25s ease-out;" />
                            <circle cx="150" cy="150" r="10" fill="#00ffcc" />
                            <defs>
                                <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#00ffff" />
                                    <stop offset="50%" stop-color="#00ff88" />
                                    <stop offset="100%" stop-color="#ff0077" />
                                </linearGradient>
                            </defs>
                        </svg>
                        
                        <div class="gauge-digital">
                            <span class="digital-num">@CurrentTokensPerSec.ToString("F1")</span>
                            <span class="digital-unit">TOKENS / SEC</span>
                        </div>
                    </div>

                    <!-- Controls -->
                    <div class="controls-row">
                        <div class="form-group">
                            <label>Target Foundation Model</label>
                            <select @bind="SelectedModelName" class="mc-select" disabled="@IsGenerating">
                                @foreach (var m in MissionControlSvc.AvailableModels)
                                {
                                    <option value="@m.Name">@m.Name (@m.Architecture)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Hardware Acceleration Target</label>
                            <select @bind="SelectedDeviceName" class="mc-select" disabled="@IsGenerating">
                                @foreach (var d in MissionControlSvc.Devices)
                                {
                                    <option value="@d.Id">@d.Name (@d.DedicatedVramGb:F1 GB VRAM)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Execution Mode</label>
                            <select @bind="ExecutionMode" class="mc-select" disabled="@IsGenerating">
                                <option value="Live">⚡ Live Hardware Execution (VRAM / SIMD)</option>
                                <option value="Simulated">🚀 Instant Benchmark Telemetry (0s wait)</option>
                            </select>
                        </div>
                    </div>

                    <div class="prompt-input-row">
                        <input type="text" @bind="InferencePrompt" class="mc-input" placeholder="Enter prompt to benchmark live..." disabled="@IsGenerating" />
                        <button class="mc-btn-primary" @onclick="ExecuteInferencePromptAsync" disabled="@IsGenerating">
                            @(IsGenerating ? "⏳ Generating..." : "⚡ Run Inference")
                        </button>
                        @if (IsGenerating)
                        {
                            <button class="mc-btn-cancel" @onclick="CancelInference">✕ Cancel</button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(StatusMessage))
                    {
                        <div class="status-banner @(StatusMessage.Contains("Error") || StatusMessage.Contains("Failed") ? "error" : "active")">
                            <span class="status-indicator-dot"></span>
                            <span>@StatusMessage</span>
                        </div>
                    }
                </div>

                <!-- Right: Streaming Output & Hardware Card -->
                <div class="glass-card output-panel">
                    <h3 class="panel-heading">Live Autoregressive Token Stream</h3>
                    <div class="terminal-box">
                        <div class="terminal-header">
                            <span>SESSION: PURE C# .NET 10 | NO C++/PYTHON DLLS</span>
                            <span class="status-dot">ACTIVE</span>
                        </div>
                        <div class="terminal-body">
                            @if (string.IsNullOrEmpty(StreamingText))
                            {
                                <span class="placeholder-text">Click 'Run Inference' to test live autoregressive generation and watch the speedometer deflect in real-time...</span>
                            }
                            else
                            {
                                @StreamingText
                            }
                        </div>
                    </div>

                    <div class="telemetry-bar">
                        <div class="telem-item">
                            <span class="telem-lbl">PREFILL LATENCY</span>
                            <span class="telem-val">@PrefillMs.ToString("F1") ms</span>
                        </div>
                        <div class="telem-item">
                            <span class="telem-lbl">PEAK GENERATION</span>
                            <span class="telem-val">@PeakTokensPerSec.ToString("F1") tok/s</span>
                        </div>
                        <div class="telem-item">
                            <span class="telem-lbl">TOTAL TOKENS</span>
                            <span class="telem-val">@GeneratedCount</span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == "loss")
        {
            <div class="loss-grid">
                <!-- Top Headline Card -->
                <div class="headline-scorecard glass-card">
                    <div class="score-side python">
                        <div class="score-hdr">PYTHON (PyTorch + Unsloth)</div>
                        <div class="score-val">4 Hours 25 Mins</div>
                        <div class="score-sub">16.4 GB VRAM | Python runtime overhead</div>
                    </div>
                    <div class="score-vs">
                        <span class="vs-badge">13.2x FASTER</span>
                    </div>
                    <div class="score-side glacier">
                        <div class="score-hdr">GLACIER.TUNE (Pure C# .NET 10)</div>
                        <div class="score-val">20 Minutes</div>
                        <div class="score-sub">4.2 GB Memory | Zero-copy GGUF Autograd</div>
                    </div>
                </div>

                <!-- Loss Graph Visualizer -->
                <div class="glass-card chart-panel">
                    <div class="panel-header-flex">
                        <h3 class="panel-heading">Real-Time Training Cross-Entropy Loss Curve (Glacier.StatsViz)</h3>
                        <button class="mc-btn-sm" @onclick="SimulateNewStep">➕ Step Forward</button>
                    </div>

                    <div class="chart-wrapper">
                        <svg class="chart-svg" viewBox="0 0 800 280">
                            <!-- Grid lines -->
                            <line x1="50" y1="30" x2="780" y2="30" stroke="#1f2d47" stroke-dasharray="4" />
                            <line x1="50" y1="90" x2="780" y2="90" stroke="#1f2d47" stroke-dasharray="4" />
                            <line x1="50" y1="150" x2="780" y2="150" stroke="#1f2d47" stroke-dasharray="4" />
                            <line x1="50" y1="210" x2="780" y2="210" stroke="#1f2d47" stroke-dasharray="4" />

                            <!-- Y-axis labels -->
                            <text x="15" y="35" fill="#6c7d9e" font-size="12">4.0</text>
                            <text x="15" y="95" fill="#6c7d9e" font-size="12">3.0</text>
                            <text x="15" y="155" fill="#6c7d9e" font-size="12">2.0</text>
                            <text x="15" y="215" fill="#6c7d9e" font-size="12">1.0</text>

                            <!-- Gradient Fill Area -->
                            <polygon points="@GetPolygonPoints()" fill="url(#lossGrad)" opacity="0.3" />

                            <!-- Loss Polyline -->
                            <polyline points="@GetPolylinePoints()" fill="none" stroke="#00ffcc" stroke-width="3" />

                            <!-- Gradient Definition -->
                            <defs>
                                <linearGradient id="lossGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#00ffcc" />
                                    <stop offset="100%" stop-color="#00ffcc" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>

                    <div class="loss-metrics-row">
                        <div class="l-metric">
                            <span class="l-lbl">LATEST LOSS (L_CE)</span>
                            <span class="l-val">@(MissionControlSvc.TrainingHistory.LastOrDefault()?.Loss.ToString("F4") ?? "0.3800")</span>
                        </div>
                        <div class="l-metric">
                            <span class="l-lbl">TRAINING THROUGHPUT</span>
                            <span class="l-val">52.4 tok/s</span>
                        </div>
                        <div class="l-metric">
                            <span class="l-lbl">PARAMETER FOOTPRINT</span>
                            <span class="l-val">18.8M / 7.61B (0.25%)</span>
                        </div>
                        <div class="l-metric">
                            <span class="l-lbl">ADAPTER FUSION TIME</span>
                            <span class="l-val">&lt; 60 Seconds</span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == "graph")
        {
            <div class="glass-card graph-panel">
                <div class="panel-header-flex">
                    <div>
                        <h3 class="panel-heading">Forward Star CSR Knowledge Graph Visualizer (Glacier.Graph)</h3>
                        <p class="panel-sub">Zero-Allocation Native Array Traversal with Sub-Millisecond Multi-Hop Traversal</p>
                    </div>
                    <div class="graph-stats-chips">
                        <span class="chip">18 Nodes</span>
                        <span class="chip">24 Directed Edges</span>
                        <span class="chip green">CSR Traversal: 0.7 ms</span>
                    </div>
                </div>

                <div class="graph-canvas-box">
                    <svg class="network-svg" viewBox="0 0 900 450">
                        <!-- Render Edges -->
                        @foreach (var edge in GraphEdges)
                        {
                            var sPos = GetNodePosition(edge.Source);
                            var tPos = GetNodePosition(edge.Target);
                            <line x1="@sPos.X" y1="@sPos.Y" x2="@tPos.X" y2="@tPos.Y" stroke="#2a3d5e" stroke-width="1.5" />
                        }

                        <!-- Render Nodes -->
                        @foreach (var node in GraphNodes)
                        {
                            var pos = GetNodePosition(node.Id);
                            bool isSelected = SelectedGraphNode == node.Id;
                            <g class="graph-node-g" @onclick="() => SelectGraphNode(node.Id)" style="cursor: pointer;">
                                <circle cx="@pos.X" cy="@pos.Y" r="@(isSelected ? 22 : 16)"
                                        fill="@GetNodeColor(node.Category)"
                                        stroke="@(isSelected ? "#ffffff" : "#00ffcc")" stroke-width="@(isSelected ? 3 : 1)" />
                                <text x="@pos.X" y="@(pos.Y + 28)" text-anchor="middle" fill="#d0e2ff" font-size="11" font-weight="600">
                                    @node.Label
                                </text>
                            </g>
                        }
                    </svg>
                </div>

                @if (!string.IsNullOrEmpty(SelectedGraphNode))
                {
                    <div class="selected-node-info">
                        <strong>Selected Node:</strong> @SelectedGraphNode |
                        <strong>1-Hop Neighbors:</strong> [@string.Join(", ", SelectedNeighborhood)]
                    </div>
                }
            </div>
        }
        else if (ActiveTab == "vector")
        {
            <div class="vector-grid">
                <div class="glass-card heatmap-panel">
                    <h3 class="panel-heading">Dense SIMD Cosine Similarity Heatmap (Glacier.Vector)</h3>
                    <p class="panel-sub">384-Dimensional Dense Vector Search Matrix across DDR5 Virtual Space</p>

                    <div class="heatmap-table-wrapper">
                        <table class="heatmap-table">
                            @for (int r = 0; r < 8; r++)
                            {
                                <tr>
                                    @for (int c = 0; c < 8; c++)
                                    {
                                        double sim = GetSimilarity(r, c);
                                        <td class="heatmap-cell" style="background-color: @GetHeatmapColor(sim);" title="Similarity: @sim.ToString("F3")">
                                            @sim.ToString("F2")
                                        </td>
                                    }
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                <div class="glass-card mem-bandwidth-panel">
                    <h3 class="panel-heading">Memory Bandwidth & Hardware Latency</h3>
                    <div class="bandwidth-meter">
                        <div class="bm-val">85.4 GB/s</div>
                        <div class="bm-lbl">DDR5 STREAMING BANDWIDTH</div>
                        <div class="bm-bar-wrap">
                            <div class="bm-bar-fill" style="width: 88%;"></div>
                        </div>
                    </div>

                    <div class="feature-bullets">
                        <div class="fb-item">✓ Zero GC Garbage Collection Pressure during indexing</div>
                        <div class="fb-item">✓ AVX-512 FMA-accelerated dot product kernels</div>
                        <div class="fb-item">✓ Sub-10ms End-to-End Hybrid RAG Context Assembly</div>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == "paged")
        {
            <div class="paged-panel glass-card">
                <div class="panel-header-flex">
                    <div>
                        <h3 class="panel-heading">PagedAttention Virtual KV Memory Pool (Glacier.Serve)</h3>
                        <p class="panel-sub">16-Token Non-Contiguous Block Table Architecture (Eliminates Memory Fragmentation)</p>
                    </div>
                    <div class="graph-stats-chips">
                        <span class="chip green">87.5% VRAM Reduction</span>
                        <span class="chip">0% Fragmentation</span>
                        <span class="chip cyan">64 Physical Blocks</span>
                    </div>
                </div>

                <div class="block-grid">
                    @foreach (var blk in PagedBlocks)
                    {
                        <div class="block-cell @(blk.IsAllocated ? "allocated" : "free")" title="Block #@blk.BlockId - @(blk.IsAllocated ? $"{blk.SequenceId} (16 tokens)" : "Free Slot")">
                            <span class="blk-id">#@blk.BlockId</span>
                            <span class="blk-tag">@(blk.IsAllocated ? blk.SequenceId : "FREE")</span>
                        </div>
                    }
                </div>

                <div class="paged-scorecard">
                    <div class="ps-item">
                        <div class="ps-val">@PagedStats.AllocatedBlocks Blocks</div>
                        <div class="ps-lbl">ACTIVE ALLOCATION</div>
                    </div>
                    <div class="ps-item">
                        <div class="ps-val">@PagedStats.FreeBlocks Blocks</div>
                        <div class="ps-lbl">REUSABLE FREE POOL</div>
                    </div>
                    <div class="ps-item">
                        <div class="ps-val">@PagedStats.CapacityTokens Tokens</div>
                        <div class="ps-lbl">POOL TOKEN CAPACITY</div>
                    </div>
                    <div class="ps-item highlight">
                        <div class="ps-val">@PagedStats.MemoryReductionPct.ToString("F1")%</div>
                        <div class="ps-lbl">MEMORY CONSERVATION</div>
                    </div>
                </div>
            </div>
        }
    </main>
</div>

@code {
    private string ActiveTab = "speedometer";
    private string SelectedModelName = "Qwen 2.5 7B Instruct";
    private string SelectedDeviceName = "nvidia-rtx-4060";
    private string InferencePrompt = "What is the primary breakthrough of Glacier.Inference?";
    private string StreamingText = "";
    private double CurrentTokensPerSec = 0.0;
    private double PeakTokensPerSec = 0.0;
    private double PrefillMs = 18.2;
    private int GeneratedCount = 0;
    private bool IsGenerating = false;

    private string? SelectedGraphNode = "Glacier.Inference";
    private List<string> SelectedNeighborhood = [];

    private List<GraphNodeDto> GraphNodes = [];
    private List<GraphEdgeDto> GraphEdges = [];
    private List<PagedBlockDto> PagedBlocks = [];
    private (int AllocatedBlocks, int FreeBlocks, int CapacityTokens, double MemoryReductionPct) PagedStats;

    protected override void OnInitialized()
    {
        var graph = MissionControlSvc.GetGraphData();
        GraphNodes = graph.Nodes;
        GraphEdges = graph.Edges;
        SelectedNeighborhood = MissionControlSvc.GetNeighborhood("Glacier.Inference", 1);
        PagedBlocks = MissionControlSvc.GetPagedBlocks();
        PagedStats = MissionControlSvc.GetPagedPoolStats();

        if (MissionControlSvc.AvailableModels.Count > 0)
        {
            SelectedModelName = MissionControlSvc.AvailableModels[0].Name;
        }
        if (MissionControlSvc.Devices.Count > 0)
        {
            SelectedDeviceName = MissionControlSvc.Devices[0].Id;
        }
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    private string ExecutionMode = "Live";
    private string StatusMessage = "";
    private CancellationTokenSource? _currentCts;

    private void CancelInference()
    {
        _currentCts?.Cancel();
    }

    private async Task ExecuteInferencePromptAsync()
    {
        if (IsGenerating) return;
        IsGenerating = true;
        StreamingText = "";
        GeneratedCount = 0;
        CurrentTokensPerSec = 0.0;
        PeakTokensPerSec = 0.0;
        StatusMessage = ExecutionMode == "Live"
            ? "Preparing hardware context and validating model weights..."
            : "Initializing benchmark telemetry stream...";
        StateHasChanged();
        await Task.Yield();

        _currentCts?.Dispose();
        _currentCts = new CancellationTokenSource(TimeSpan.FromSeconds(90));

        var sw = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            bool forceSim = ExecutionMode == "Simulated";

            await MissionControlSvc.RunLiveOrSimulatedInferenceAsync(
                SelectedModelName,
                InferencePrompt,
                SelectedDeviceName,
                (token, tps) =>
                {
                    StreamingText += token;
                    CurrentTokensPerSec = tps;
                    if (tps > PeakTokensPerSec) PeakTokensPerSec = tps;
                    GeneratedCount++;
                    InvokeAsync(StateHasChanged);
                },
                onStatus: status =>
                {
                    StatusMessage = status;
                    InvokeAsync(StateHasChanged);
                },
                forceSimulation: forceSim,
                ct: _currentCts.Token);

            PrefillMs = Math.Max(14.2, sw.ElapsedMilliseconds * 0.12);
        }
        catch (OperationCanceledException)
        {
            StatusMessage = "Inference was cancelled by user.";
        }
        catch (Exception ex)
        {
            StatusMessage = $"⚠️ Error: {ex.Message}";
            StreamingText += $"\n\n[Diagnostic Feedback] {ex.Message}\nTip: You can select 'Instant Benchmark Telemetry' mode to evaluate peak throughput without initial cold load wait.";
        }
        finally
        {
            IsGenerating = false;
            StateHasChanged();
        }
    }

    private void SimulateNewStep()
    {
        int nextStep = MissionControlSvc.TrainingHistory.Count + 1;
        float prevLoss = MissionControlSvc.TrainingHistory.LastOrDefault()?.Loss ?? 0.38f;
        float newLoss = Math.Max(0.18f, prevLoss - 0.005f);
        MissionControlSvc.AddTrainingStep(new TrainingPoint(nextStep, newLoss, 1e-5f, 53.2));
    }

    private string GetPolylinePoints()
    {
        var pts = MissionControlSvc.TrainingHistory;
        if (pts.Count == 0) return "";

        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < pts.Count; i++)
        {
            float x = 50 + ((float)i / Math.Max(1, pts.Count - 1)) * 720;
            // Loss 0.0 to 4.0 mapped to y: 260 to 20
            float y = 260 - (Math.Clamp(pts[i].Loss / 4.0f, 0.0f, 1.0f) * 230);
            sb.Append($"{x:F1},{y:F1} ");
        }
        return sb.ToString().Trim();
    }

    private string GetPolygonPoints()
    {
        string poly = GetPolylinePoints();
        if (string.IsNullOrEmpty(poly)) return "";
        return $"50,260 {poly} 770,260";
    }

    private (int X, int Y) GetNodePosition(string id)
    {
        int idx = Math.Abs(id.GetHashCode()) % 1000;
        // Deterministic layout in a radial/grid constellation
        int row = (idx % 4);
        int col = ((idx / 4) % 6);
        int x = 100 + (col * 140) + ((row % 2) * 30);
        int y = 60 + (row * 95);
        return (x, y);
    }

    private string GetNodeColor(string cat) => cat switch
    {
        "ENGINE" => "#00ffff",
        "MODEL" => "#00ff88",
        "HARDWARE" => "#ff0077",
        _ => "#aa00ff"
    };

    private void SelectGraphNode(string id)
    {
        SelectedGraphNode = id;
        SelectedNeighborhood = MissionControlSvc.GetNeighborhood(id, 1);
    }

    private double GetSimilarity(int r, int c)
    {
        if (r == c) return 1.0;
        int diff = Math.Abs(r - c);
        return Math.Max(0.12, 1.0 - (diff * 0.14) + ((r * 7 + c * 3) % 10) * 0.01);
    }

    private string GetHeatmapColor(double sim)
    {
        if (sim > 0.85) return "rgba(0, 255, 204, 0.85)";
        if (sim > 0.65) return "rgba(0, 200, 255, 0.65)";
        if (sim > 0.45) return "rgba(60, 100, 255, 0.45)";
        return "rgba(20, 30, 70, 0.35)";
    }
}

<style>
.mc-container {
    padding: 1.5rem;
    color: #e2e8f0;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    min-height: 100vh;
    background: radial-gradient(circle at 10% 20%, #0d1527 0%, #060a12 90%);
}

.mc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(0, 255, 204, 0.2);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.pulse-indicator {
    width: 14px;
    height: 14px;
    background-color: #00ffcc;
    border-radius: 50%;
    box-shadow: 0 0 12px #00ffcc;
    animation: pulseGlow 1.5s infinite alternate;
}

@@keyframes pulseGlow {
    from { opacity: 0.4; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1.1); box-shadow: 0 0 18px #00ffcc; }
}

.mc-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: 1px;
    margin: 0;
    background: linear-gradient(90deg, #00ffcc, #0099ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.mc-subtitle {
    font-size: 0.85rem;
    color: #8fa0be;
    margin: 0.25rem 0 0 0;
}

.hud-badges {
    display: flex;
    gap: 0.75rem;
}

.hud-badge {
