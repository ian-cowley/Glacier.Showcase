@page "/gpu"
@using Glacier.Showcase.Services
@using System.Runtime.Intrinsics
@inject GpuAccelerationBenchmarkService BenchmarkService
@rendermode InteractiveServer

<PageTitle>Glacier Suite - Bare-Metal GPU Acceleration</PageTitle>

<div class="container-fluid py-4" style="max-width: 1400px;">
    <!-- Header Banner -->
    <div class="card shadow-sm border-0 mb-4" style="background: linear-gradient(135deg, #0d1b2a, #1b263b); color: #e0e1dd; border-radius: 12px;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap">
                <div>
                    <h2 class="fw-bold mb-1" style="color: #48cae4;">
                        <i class="bi bi-cpu-fill me-2"></i>Glacier Bare-Metal GPU &amp; SIMD Acceleration
                    </h2>
                    <p class="mb-0 text-light opacity-75">
                        Direct P/Invoke driver and hardware intrinsic execution across NVIDIA CUDA/SASS, Direct3D 12 / DirectML, and CPU AVX-512 / AVX2.
                    </p>
                </div>
                <div class="mt-3 mt-md-0">
                    <span class="badge @(BenchmarkService.IsGpuAvailable ? "bg-success" : "bg-info text-dark") px-3 py-2 fs-6 shadow-sm">
                        <i class="bi bi-shield-check me-1"></i>
                        @(BenchmarkService.IsGpuAvailable ? "Zero-SDK Bare-Metal GPU Active" : "SIMD Vectorized CPU Engine Active")
                    </span>
                </div>
            </div>
            <hr style="border-color: rgba(255,255,255,0.15);" />
            <div class="row g-3 text-center">
                <div class="col-md-6">
                    <div class="p-2 rounded" style="background: rgba(255,255,255,0.05);">
                        <small class="text-uppercase tracking-wider opacity-75">Detected Compute Target</small>
                        <div class="fw-bold text-info">@BenchmarkService.DetectedHardware</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-2 rounded" style="background: rgba(255,255,255,0.05);">
                        <small class="text-uppercase tracking-wider opacity-75">Host CPU Vector Intrinsics</small>
                        <div class="fw-bold text-success">@GetSimdProfile()</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Ecosystem GPU &amp; Accelerator Performance Verification</h4>
            <small class="text-muted">Benchmarks all 6 core compute pillars on physical hardware with numerical parity verification.</small>
        </div>
        <div>
            <button class="btn btn-primary btn-lg shadow px-4" @onclick="RunBenchmarks" disabled="@IsRunning">
                @if (IsRunning)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Benchmarking Compute Cores...</span>
                }
                else
                {
                    <i class="bi bi-lightning-charge-fill me-2"></i>
                    <span>Execute All Benchmarks</span>
                }
            </button>
        </div>
    </div>

    <!-- Results Table -->
    @if (Results != null && Results.Count > 0)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-primary border-4 p-3 bg-white rounded-3">
                    <small class="text-muted text-uppercase fw-semibold">Pillars Verified</small>
                    <h3 class="fw-bold text-primary mb-0">@Results.Count(r => r.Verified) / @Results.Count</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-success border-4 p-3 bg-white rounded-3">
                    <small class="text-muted text-uppercase fw-semibold">Peak Speedup</small>
                    <h3 class="fw-bold text-success mb-0">@GetMaxSpeedup()x</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-info border-4 p-3 bg-white rounded-3">
                    <small class="text-muted text-uppercase fw-semibold">Peak Tensor Compute</small>
                    <h3 class="fw-bold text-info mb-0">@GetTensorFlops() TFLOPS</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-warning border-4 p-3 bg-white rounded-3">
                    <small class="text-muted text-uppercase fw-semibold">Numerical Parity</small>
                    <h3 class="fw-bold @(Results.All(r => r.Verified) ? "text-success" : "text-danger") mb-0">
                        @(Results.All(r => r.Verified) ? "All Verified" : "Discrepancy")
                    </h3>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3 ps-3">Pillar / Repository</th>
                            <th class="py-3">Operation</th>
                            <th class="py-3">Workload Dataset</th>
                            <th class="py-3 text-end">CPU Baseline</th>
                            <th class="py-3 text-end">Auto Accelerator</th>
                            <th class="py-3 text-end">Speedup</th>
                            <th class="py-3 text-end">Throughput</th>
                            <th class="py-3 text-center pe-3">Parity Check</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Results)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">
                                    <i class="bi bi-box-seam me-1"></i>@res.Pillar
                                </td>
                                <td>@res.Operation</td>
                                <td><span class="badge bg-light text-dark border">@res.Workload</span></td>
                                <td class="text-end font-monospace">@res.CpuTimeMs.ToString("F3") ms</td>
                                <td class="text-end font-monospace fw-bold text-success">@res.GpuTimeMs.ToString("F3") ms</td>
                                <td class="text-end">
                                    <span class="badge @(res.Speedup >= 2.0 ? "bg-success" : "bg-primary") px-2 py-1">
                                        @res.Speedup.ToString("F1")x
                                    </span>
                                </td>
                                <td class="text-end font-monospace fw-semibold text-dark">
                                    @res.MetricValue.ToString("F2") @res.MetricName.Replace("Throughput ", "").Replace("Compute ", "").Replace("Rate ", "").Replace("Decimation ", "").Replace("Eval ", "")
                                </td>
                                <td class="text-center pe-3">
                                    @if (res.Verified)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Fail
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (!IsRunning)
    {
        <div class="card shadow-sm border-0 p-5 text-center bg-light rounded-3">
            <i class="bi bi-gpu-card text-muted" style="font-size: 3.5rem;"></i>
            <h4 class="mt-3 fw-bold">Ready to Benchmark Compute Ecosystem</h4>
            <p class="text-muted" style="max-width: 600px; margin: 0 auto;">
                Click <strong>"Execute All Benchmarks"</strong> above to run live compute kernels across
                Glacier.Polaris, Glacier.ML, Glacier.Tensor, Glacier.Vector, Glacier.Plot, and Glacier.StatsViz.
            </p>
        </div>
    }
</div>

@code {
    private bool IsRunning = false;
    private List<BenchmarkResult>? Results;

    private static string GetSimdProfile()
    {
        string width = Vector512.IsHardwareAccelerated ? "512-bit AVX-512" :
                       Vector256.IsHardwareAccelerated ? "256-bit AVX2" :
                       Vector128.IsHardwareAccelerated ? "128-bit SIMD" : "Scalar";
        return $"{Environment.ProcessorCount} Logical Cores ({width})";
    }

    private async Task RunBenchmarks()
    {
        IsRunning = true;
        StateHasChanged();
        try
        {
            Results = await BenchmarkService.RunAllBenchmarksAsync();
        }
        finally
        {
            IsRunning = false;
            StateHasChanged();
        }
    }

    private string GetMaxSpeedup()
    {
        if (Results == null || Results.Count == 0) return "1.0";
        double max = 0;
        foreach (var r in Results) if (r.Speedup > max) max = r.Speedup;
        return max.ToString("F1");
    }

    private string GetTensorFlops()
    {
        var tensor = Results?.Find(r => r.Pillar == "Glacier.Tensor");
        return tensor != null ? tensor.MetricValue.ToString("F2") : "0.00";
    }
}
