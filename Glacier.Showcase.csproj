<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>47cdd2e8-4238-4e3b-8228-d39795881c39</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="Glacier.Inference" Version="1.3.2" />
    <PackageReference Include="Glacier.Tune" Version="1.0.7" />
    <PackageReference Include="Glacier.Serve" Version="1.2.0" />
    <PackageReference Include="Glacier.Rag" Version="1.2.0" />
    <PackageReference Include="Glacier.Gpu" Version="1.1.0" />
    <PackageReference Include="Glacier.Polaris" Version="1.1.0" />
    <PackageReference Include="Glacier.Vector" Version="1.1.0" />
    <PackageReference Include="Glacier.ML" Version="1.1.0" />
    <PackageReference Include="Glacier.Tensor" Version="1.1.0" />
    <PackageReference Include="Glacier.Plot" Version="1.1.0" />
    <PackageReference Include="Glacier.StatsViz" Version="1.1.0" />
    <PackageReference Include="Glacier.DocTree" Version="1.2.0" />
    <PackageReference Include="Glacier.Graph" Version="1.1.0" />
    <PackageReference Include="Glacier.AgentDevKit.Adk" Version="1.1.0" />
    <PackageReference Include="TinyPdf" Version="0.2.0" />
  </ItemGroup>

</Project>
